[Unit]
Description=IPFS Daemon for Video Uploader
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment="IPFS_PATH=/var/www/video-uploader/.ipfs"
ExecStart=/usr/local/bin/ipfs daemon
Restart=always
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/video-uploader/.ipfs

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ipfs-uploader

[Install]
WantedBy=multi-user.target
